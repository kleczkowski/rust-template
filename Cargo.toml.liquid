[workspace.package]
version = "0.1.0"
authors = ["{{ authors }}"]
description = "{{ project_description }}"
license = "MIT"
repository = "https://github.com/{{ github_username }}/{{ project-name }}"
edition = "2024"

[workspace]
members = ["crates/app", "crates/library"]
resolver = "3"

[workspace.dependencies]
{{ project-name }}-library = { path = "crates/library" }

[workspace.lints.rust]
missing-docs = "warn"
nonstandard-style = "deny"
redundant-lifetimes = "warn"
rust-2018-idioms = "deny"
unreachable-pub = "warn"
unsafe-code = "deny"
unused-extern-crates = "warn"
unused-imports = "warn"
unused-must-use = "deny"
unused-qualifications = "warn"

[workspace.lints.clippy]
pedantic = { level = "warn", priority = -1 }
allow-attributes = "deny"
dbg-macro = "warn"
indexing-slicing = "warn"
panic-in-result-fn = "deny"
redundant-clone = "warn"
todo = "warn"
unimplemented = "deny"
module-name-repetitions = "allow"
similar-names = "allow"
must-use-candidate = "allow"

[workspace.lints.rustdoc]
all = { level = "warn", priority = -1 }
broken-intra-doc-links = "deny"
private-intra-doc-links = "deny"
